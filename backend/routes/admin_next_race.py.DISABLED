# backend/routes/admin_next_race.py
import os
from fastapi import APIRouter, Request, HTTPException

from backend.services.kra_crawler import (
    fetch_simple,        # ✅ 함수명 수정
    upsert,
    next_race
)

try:
    from backend.services.db import DB_PATH
except Exception:
    DB_PATH = os.path.join(
        os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
        "races.db"
    )

router = APIRouter(prefix="/api/admin", tags=["admin-crawl"])
ADMIN_PASSWORD = os.getenv("ADMIN_PASSWORD", "")

def _auth(request: Request):
    token = request.headers.get("x-admin-token", "")
    if token != ADMIN_PASSWORD:
        raise HTTPException(status_code=401, detail="unauthorized")

@router.get("/crawl")
def crawl_today(request: Request):
    _auth(request)

    rows = fetch_simple()          # ✅ 여기서도 동일
    result = upsert(DB_PATH, rows)

    return {
        "ok": True,
        "race_date": result.get("race_date"),
        "inserted_or_replaced": result.get("inserted_or_replaced"),
    }

@router.get("/next-race")
def get_next_race(request: Request):
    _auth(request)
    return {
        "ok": True,
        "next_race": next_race(DB_PATH)
    }
